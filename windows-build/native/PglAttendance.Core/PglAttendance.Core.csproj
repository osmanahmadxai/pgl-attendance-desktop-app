<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PglAttendance.Core</RootNamespace>
    <AssemblyName>PglAttendance.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Bundles the IANA timezone database, so zone names resolve the same on every machine.
         The OS cannot be relied on: the service runs with InvariantGlobalization (no ICU), where
         Windows does not understand names like Asia/Dubai. -->
    <PackageReference Include="NodaTime" Version="3.2.0" />
  </ItemGroup>
</Project>
